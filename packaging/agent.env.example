# C4 Agent 环境变量模板
#
# 安装时（postinst / install.sh）仅在 agent.env 不存在的情况下，据此创建
# agent.env 并设为 root:c4 0640。已存在的 agent.env 永远不会被覆盖——
# 请勿在此模板中填写真实密钥，改为在部署机上编辑实际的 agent.env。
#
# 用法：
#   sudo install -m 640 -o root -g c4 \
#       /usr/local/etc/c4/agent.env.example /usr/local/etc/c4/agent.env
#   sudo vim /usr/local/etc/c4/agent.env
#
DEEPSEEK_API_KEY=
