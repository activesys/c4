# C4 Agent 环境变量模板
#
# 安装时（postinst / install.sh）仅在 agent.env 不存在的情况下，据此创建
# agent.env 并设为 root:c4 0640。已存在的 agent.env 永远不会被覆盖——
# 请勿在此模板中填写真实密钥，改为在部署机上编辑实际的 agent.env。
#
# 用法：
#   sudo install -m 640 -o root -g c4 \
#       /usr/local/etc/c4/agent.env.example /usr/local/etc/c4/agent.env
#   sudo vim /usr/local/etc/c4/agent.env
#
DEEPSEEK_API_KEY=

# ── MCP 服务日志开关（stderr → journald，asfp2 起支持；详见 c4_asfp2_server.md §9）──
# 子进程继承本文件注入的环境变量；取消注释即可覆盖默认值
# C4_MCP_LOG_LEVEL=info          # crit / err / warning / info / debug（默认 info）
# C4_MCP_LOG_FORMAT=text         # text / json（默认 text）
# C4_MCP_LOG_STATS_INTERVAL=60   # 数据面周期统计秒数，0=关闭（默认 60）
