{
  "service_type": "c4_modbus_client",
  "display_name": "Modbus 数据采集",
  "role": "writer",
  "protocols": [{
    "protocol": "modbus",
    "description": "Modbus TCP 数据采集客户端，从工业设备读取数据后写入共享内存",
    "selection_rules": [
      { "condition": "device.protocol == 'modbus'", "description": "Modbus 协议设备数据采集" }
    ]
  }],
  "point_fields": [
    { "name": "addr", "type": "integer", "description": "寄存器地址" },
    { "name": "uid",  "type": "integer", "description": "单元标识符" },
    { "name": "fun",  "type": "integer", "description": "功能码" },
    { "name": "type", "type": "integer", "description": "数据类型" },
    { "name": "swap", "type": "integer", "description": "字节交换" }
  ],
  "config_schema": {
    "fields": {
      "ip":         { "type": "string",  "source": "plan",    "default": null,  "description": "设备 IP 地址" },
      "port":       { "type": "integer", "source": "plan",    "default": 502,   "description": "Modbus 端口（默认 502）" },
      "t0":         { "type": "integer", "source": "default", "default": 30,    "description": "连接超时（秒）" },
      "t1":         { "type": "integer", "source": "default", "default": 10,    "description": "请求/响应超时（秒）" },
      "retries":    { "type": "integer", "source": "default", "default": 10,    "description": "失败重试次数" },
      "coils_quantity_max":     { "type": "integer", "source": "default", "default": 2000, "description": "单次请求最大线圈/离散输入数量" },
      "registers_quantity_max": { "type": "integer", "source": "default", "default": 125,  "description": "单次请求最大寄存器数量" },
      "hton_register": { "type": "integer", "source": "default", "default": 1,   "description": "是否将每个 16 位寄存器的网络序格式转换为本机序格式（1=转换，0=不转换）" },
      "hton_total":  { "type": "integer", "source": "default", "default": 0,     "description": "保留字段（始终为 0）" },
      "timer":       { "type": "integer", "source": "default", "default": 1000,  "description": "采集周期（毫秒）" }
    }
  },
  "binary_path": "/usr/local/bin/c4_modbus_client",
  "error_mappings": {
    "ALREADY_RUNNING": "服务已在运行中，无需重复启动",
    "CONFIG_PATH_MISSING": "配置文件路径无效，请检查 Agent 部署是否正确",
    "CONFIG_PARSE_ERROR": "配置文件格式错误，请检查配置内容",
    "SHM_CORRUPTED": "数据存储异常，请联系管理员检查共享内存状态",
    "SHM_OPEN_FAILED": "无法访问数据存储，请检查共享内存配置",
    "SHM_ID_NOT_ASSIGNED": "数据点未分配通道，请重新生成接入方案",
    "INVALID_POINT": "数据点配置无效，请检查功能码/地址/数据类型",
    "CONNECT_FAILED": "设备连接失败，请检查设备 IP 和端口"
  }
}
