{
  "instance_id": "c4",
  "model": {
    "provider": "zhipu",
    "name": "glm-5.3-flash",
    "base_url": "https://open.bigmodel.cn/api/coding/paas/v4",
    "temperature": 0,
    "max_tokens": 4096,
    "api_key_env": "ZHIPU_API_KEY",
    "thinking": "disabled"
  },
  "server": {
    "host": "0.0.0.0",
    "port": 9988,
    "cors_origin": "*"
  },
  "mcp_registry": {
    "path": "/usr/local/etc/c4/mcp-registry"
  },
  "shm_manager": {
    "binary": "/usr/local/bin/c4_shm_manager",
    "config_path": "~/.local/c4/config.json"
  },
  "state": {
    "backend": "memory",
    "path": "~/.local/c4/state"
  },
  "logging": {
    "level": "info",
    "dir": "/var/log/c4/agent",
    "agent_level": "debug"
  },
  "frontend": {
    "dir": "/usr/local/lib/c4/frontend"
  },
  "site": {
    "name": "华能阿拉善",
    "abbr": "hnals"
  }
}