{
  "instance_id": "c4",
  "model": {
    "provider": "deepseek",
    "name": "deepseek-chat",
    "temperature": 0,
    "max_tokens": 4096,
    "api_key_env": "DEEPSEEK_API_KEY"
  },
  "server": {
    "host": "127.0.0.1",
    "port": 3000,
    "cors_origin": "*"
  },
  "mcp_registry": {
    "path": "/usr/local/etc/c4/mcp-registry"
  },
  "shm_manager": {
    "binary": "/usr/local/bin/c4_shm_manager",
    "config_path": "~/.local/c4/config.json"
  },
  "state": {
    "backend": "memory",
    "path": "~/.local/c4/state"
  },
  "logging": {
    "level": "info",
    "dir": "~/.local/c4/logs"
  },
  "site": {
    "name": "华能阿拉善",
    "abbr": "hnals"
  }
}
